{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sellemond.at/schemas/generation-result.json",
  "title": "Invoice generation result",
  "description": "Single JSON object printed to stdout in --format=json mode. Exactly one of GenerationResult (success) or ErrorEnvelope (failure) is emitted.",
  "oneOf": [
    { "$ref": "#/$defs/GenerationResult" },
    { "$ref": "#/$defs/ErrorEnvelope" }
  ],
  "$defs": {
    "GenerationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoiceNumber", "pdfPath", "customer", "issuer", "period",
        "hours", "net", "vat", "gross", "attachments", "warnings"
      ],
      "properties": {
        "invoiceNumber": { "type": "string" },
        "pdfPath": { "type": "string", "description": "Absolute path to the generated invoice PDF" },
        "customer": { "type": "string" },
        "issuer": { "type": "string" },
        "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "hours": { "type": "number", "description": "Billed hours, exact decimal" },
        "net": { "type": "number" },
        "vat": { "type": "number" },
        "gross": { "type": "number" },
        "attachments": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Absolute paths attached to the draft; [invoicePdf, harvestReportPdf] when mail enabled, else []"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Non-fatal side-effect failures; empty on a clean run"
        }
      }
    },
    "ErrorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_ARGUMENTS",
                "UNKNOWN_ISSUER",
                "UNKNOWN_CUSTOMER",
                "INVALID_PERIOD",
                "MISSING_HOURS",
                "MISSING_REPORT_PDF",
                "UNMAPPED_HARVEST_PROJECT",
                "HARVEST_FETCH_FAILED",
                "UNEXPECTED_ERROR"
              ]
            },
            "message": { "type": "string" }
          }
        }
      }
    }
  }
}
