<?xml version="1.0" encoding="UTF-8"?>
<!--
  Route all console logging to STDERR so that, in JSON output mode, STDOUT carries only the
  single machine-readable JSON result. Interactive prompts (which use System.out) are unaffected.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
